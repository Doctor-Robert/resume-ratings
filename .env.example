# Скопируйте этот файл в .env и заполните значения: cp .env.example .env

# База данных
POSTGRES_USER=resume
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume

# Секрет для подписи токенов входа (длинная случайная строка)
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me

# LLM (OpenRouter): ключ берётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
