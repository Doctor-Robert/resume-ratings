# Скопируйте этот файл в .env и заполните значения: cp .env.example .env

# База данных
POSTGRES_USER=resume
POSTGRES_PASSWORD=
POSTGRES_DB=resume

# Внешний порт сайта (на локальной машине обычно 80)
WEB_PORT=80

# Секрет для подписи токенов входа (длинная случайная строка)
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# true только если сайт доступен по HTTPS; для локального HTTP оставить false
COOKIE_SECURE=false

# LLM (OpenRouter): ключ берётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free
